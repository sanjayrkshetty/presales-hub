# ── REQUIRED in production — set these or the app will not start ──────────────

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING

# PostgreSQL connection string (SQLite is only for development)
DATABASE_URL=postgresql://user:password@db:5432/presales_hub

# Redis
REDIS_URL=redis://redis:6379

# Platform admin key — keep secret, rotate quarterly
PLATFORM_ADMIN_KEY=CHANGE_ME_PLATFORM_ADMIN_KEY

# ── Environment ───────────────────────────────────────────────────────────────

ENVIRONMENT=production
DEBUG=false

# Comma-separated list of allowed frontend origins (no wildcards — credentials are sent)
ALLOWED_ORIGINS=["https://app.presaleshub.io"]

# ── Token lifetimes ───────────────────────────────────────────────────────────

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM providers (set the ones you use) ─────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
