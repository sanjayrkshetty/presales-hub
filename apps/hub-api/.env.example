DATABASE_URL=sqlite:///./presales_hub.db
# For production: postgresql://user:pass@host:5432/presales_hub
PROPOSAL_ENGINE_URL=http://localhost:8004
ALLOWED_ORIGIN=http://localhost:3002
REDIS_URL=redis://localhost:6379/0

# Observability
SERVICE_NAME=hub-api
# Set to Jaeger/Tempo OTLP endpoint to enable remote tracing (console exporter used if unset)
OTLP_ENDPOINT=http://localhost:4318

# Optional: Langfuse LLM observability (leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
