# NEVER commit this file with real values. Use sealed-secrets or external-secrets operator in prod.
# Generate base64: echo -n "value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: presales-hub-secrets
  namespace: presales-hub
type: Opaque
data:
  DATABASE_URL: <base64-encoded-postgres-url>
  REDIS_URL: <base64-encoded-redis-url>
  SECRET_KEY: <base64-encoded-jwt-secret>
  ANTHROPIC_API_KEY: <base64-encoded-key>
