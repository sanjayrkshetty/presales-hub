# ── Presales Hub — Full Local Stack ──────────────────────────────────────────
# Copy to .env.full and adjust values, then: make up
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=presales
POSTGRES_PASSWORD=presales_dev
POSTGRES_DB=presales_hub

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://presales:presales_dev@postgres:5432/presales_hub
REDIS_URL=redis://redis:6379
TEMPORAL_HOST=temporal:7233
OTLP_ENDPOINT=http://jaeger:4318

JWT_SECRET_KEY=dev-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

PLATFORM_ADMIN_KEY=dev-admin-key
ENVIRONMENT=development
DEBUG=true

# Comma-separated CORS origins
ALLOWED_ORIGINS=["http://localhost:3002","http://hub-dashboard:3002"]

# Optional LLM keys (degrades gracefully if absent)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_HUB_API_URL=http://localhost:8003

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_POSTGRES_DB=temporal
